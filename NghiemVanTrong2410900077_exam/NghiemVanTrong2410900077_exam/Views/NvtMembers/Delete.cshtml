@model NghiemVanTrong2410900077_exam.Models.NvtMember

@{
    ViewData["Title"] = "Xóa thành viên";
}

<div class="container mt-4">

    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Xác nhận xóa thành viên</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                Bạn có chắc chắn muốn xóa thành viên này?
            </div>

            <table class="table table-bordered">

                <tr>
                    <th width="30%">Họ và tên</th>
                    <td>@Model.Name</td>
                </tr>

                <tr>
                    <th>Giới tính</th>
                    <td>
                        @(Model.Gender == true ? "Nam" : "Nữ")
                    </td>
                </tr>

                <tr>
                    <th>Ngày sinh</th>
                    <td>
                        @(Model.BirthDay?.ToString("dd/MM/yyyy"))
                    </td>
                </tr>

                <tr>
                    <th>Email</th>
                    <td>@Model.Email</td>
                </tr>

                <tr>
                    <th>Số điện thoại</th>
                    <td>@Model.Phone</td>
                </tr>

                <tr>
                    <th>Trạng thái</th>
                    <td>
                        @(Model.Active == true ? "Hoạt động" : "Khóa")
                    </td>
                </tr>

            </table>

            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Xóa
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Hủy
                </a>

            </form>

        </div>
    </div>
</div>