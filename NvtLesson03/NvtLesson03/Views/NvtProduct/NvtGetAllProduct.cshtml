@{
	ViewData["Title"] = "Danh sách sản phẩm";

	var products = ViewData["products"] as List<NvtLesson03.Models.NvtProduct>;
	int stt = 0;
}

<h1>NvtGetAllProduct</h1>
<div class="card">
	<div class="card-header">
		<h1>@ViewData["Title"]</h1>

	</div>
	<div class="card-body">
		<table class="table table-bordered table-striped">
			<thead>
				<tr>
					<th>#</th>
					<th>ID</th>
					<th>Name</th>
					<th>Year</th>
					<th>Price</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				@foreach(NvtProduct item in products )
				{
					stt++;
					<tr>
						<td>@stt</td>
						<td>@item.NvtProductId</td>
						<td>@item.NvtProductName</td>
						<td>@item.NvtYearRelease</td>
						<td>@item.NvtPrice</td>
						<td>
							<a href="#">Xem</a>
							<a href="#">  Sửa</a>
							<a href="#"> Xóa</a>
						</td>
					</tr>
				}
			</tbody>
			<tfoot>
				<tr>
					<th colspan="6"> Tổng số sản phẩm :@products.Count</th>
				</tr>
			</tfoot>

		</table>
	</div>

</div>